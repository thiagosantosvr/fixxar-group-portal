# Deny direct HTTP access to private configuration, diagnostics and legacy setup/API files.
<FilesMatch "^(diagnostico\.php|teste-php\.php|acesso-inicial\.php|instalar-admin\.php|index_antigo\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config\.php|config\.example\.php|.*\.(sql|md))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

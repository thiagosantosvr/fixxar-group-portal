# Deny direct HTTP access to private configuration and deployment/source files.
<FilesMatch "^(config\.php|config\.example\.php|.*\.(sql|md))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
